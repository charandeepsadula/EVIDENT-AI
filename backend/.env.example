APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001","https://evident-ai-frontend-elsx.onrender.com"]
LOCAL_DEV_MODE=true
# Match NEXT_PUBLIC_LOCAL_DEV_TOKEN in frontend/.env.local. Use only on localhost.
LOCAL_DEV_TOKEN=replace-with-a-random-value-at-least-32-characters
LOCAL_DATABASE_PATH=./data/evident.sqlite3

# Optional provider keys. Without both Gemini and Tavily, no fact verdict is produced.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Keep this server-only. Never use it in frontend/.env.local.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional. Must be enabled for generateContent on this API key; verified before use.
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
TAVILY_API_KEY=
REDIS_URL=
