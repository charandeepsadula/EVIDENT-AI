# Reference only. Copy the individual templates:
# frontend/.env.example -> frontend/.env.local
# backend/.env.example -> backend/.env
# Set the same strong random local token in both files.

# Local MVP mode: no Supabase or Redis required.
APP_ENV=development
LOCAL_DEV_MODE=true
LOCAL_DEV_TOKEN=replace-with-the-same-random-value-in-both-apps
LOCAL_DATABASE_PATH=./data/evident.sqlite3
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
TAVILY_API_KEY=
